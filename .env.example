# Which market-data provider the server uses: "yfinance" (default) or "simulated".
MARKET_DATA_PROVIDER=yfinance

# URL of the Python yfinance market-data service (market-data-service/main.py)
YFINANCE_SERVICE_URL=http://127.0.0.1:8765

# Future providers — keys stay server-side only (never prefix with NEXT_PUBLIC_)
# POLYGON_API_KEY=
# TRADIER_API_KEY=
# FINNHUB_API_KEY=

